# NexusAI Master Environment Template (Safe for Public Repositories / GitHub)
# Copy this file to '.env' on your server or local machine and insert your credentials.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth 2.0 Credentials (From https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# CEO Executive Passcode
CEO_PASSCODE=!Catch me if you can Hacker!

# Server Hosting Network
HOST=0.0.0.0
PORT=8000
